AWS_BEDROCK_MODEL_ID=qwen.qwen3-coder-next

# Voice TTS (OpenAI)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# YouTube API Key
YOUTUBE_API_KEY=your_youtube_api_key_here

# Restream API Key
RESTREAM_CLIENT_ID=your_client_id
